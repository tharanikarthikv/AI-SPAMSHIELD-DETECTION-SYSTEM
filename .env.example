# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# For local Cursor / Antigravity development, set your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Port configuration (the deployment platform may inject PORT)
PORT=3000
NODE_ENV=development

# APP_URL: the public URL where this app is hosted (update in deployment settings).
APP_URL="http://localhost:3000"

# Gmail OAuth is configured in Firebase Console. Add localhost and your deployed
# hostname under Authentication → Settings → Authorized domains.
